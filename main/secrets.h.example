#pragma once

/*
 * 复制成 secrets.h 填入自己的值即可（secrets.h 已在 .gitignore 里，不会进仓库）
 *
 *   cp main/secrets.h.example main/secrets.h
 *
 * 不填也能编译，但会用占位符 "CHANGE_ME"，设备连不上 WiFi/MQTT。
 * 也可以只填一半：运行时可从设备网页（http://<设备IP>/）改 WiFi / MQTT，
 * 改完存 NVS，优先级高于这里的编译期默认值。
 */

/* Wi-Fi */
#define APP_SECRET_WIFI_SSID        "CHANGE_ME"
#define APP_SECRET_WIFI_PASSWORD    "CHANGE_ME"

/* MQTT（mqtt:// 明文 或 mqtts:// TLS，端口分别 1883 / 8883） */
#define APP_SECRET_MQTT_URI         "mqtt://mqtt.example.com:1883"
#define APP_SECRET_MQTT_USERNAME    "mqtt"
#define APP_SECRET_MQTT_PASSWORD    "CHANGE_ME"

/* 固件/OTA 的 HTTP 根地址：设备会去 <base>/local/switchyard/<id>/ 拉 manifest 与固件 */
#define APP_SECRET_OTA_BASE_URL     "https://ha.example.com"
